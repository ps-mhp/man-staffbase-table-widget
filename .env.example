# Copy to `.env` (gitignored) and fill in. Used by scripts/install.sh.

# Staffbase instance the widgets are installed into.
STAFFBASE_API_URL=https://app.staffbase.com

# API token, sent as `Authorization: Basic $STAFFBASE_API_TOKEN`.
STAFFBASE_API_TOKEN=

# Widgets scripts/install.sh installs by default (space or comma separated).
# Known: table-widget search-bar-widget
STAFFBASE_WIDGETS=table-widget
